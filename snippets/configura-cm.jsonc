	"Bash: KimInt Directory": {
		"prefix": "derick-kimint-directory",
		"body": [
			"cd extensions/custom/kimballinternational",
		  ],
		"description": "Change directory to kimballinternational"
	},

	"Add: Comment": {
		"prefix": "derick-comment",
		"body": [
			"/**",
			" * ${1:${TM_SELECTED_TEXT}}",
			" */",
			"",
		  ],
		"description": "Creates a descriptive comment block"
	},

	"Add: Area Comment": {
		"prefix": "derick-area-comment",
		"body": [
			"/***********************************************************************",
			" * ${1:${TM_SELECTED_TEXT}}",
			" ***********************************************************************/",
			"",
			"",
		],
		"description": "Creates a section/header comment block"
	},

	"Add: pln()": {
		"prefix": "derick-pln",
		"scope": "configura-cm",
		"body": [
			"pln(#${1:${TM_SELECTED_TEXT}});",
		  ],
		"description": "Creates a descriptive comment block"
	},

	
	"Add: Append/Remove Attributes to Dimensions": {
		"prefix": "derick-append-remove-attributes-to-dimensions",
		"scope": "configura-cm",
		"body": [
			"construct {",
			"    if (PropDef def = propDefs.get(cKimIntW)) {",
			"        def.setting.?PropInputSetting.?attributes += {cKimIntQuickAttr, cKimIntPersistentAttr};",
			"        def.setting.?PropInputSetting.?attributes.remove(cKimIntLockableAttr);",
			"    }",
			"}"
		],
		"description": "Appends and removes attributes to dimensions"
	},

	"Add: RS Entry": {
		"prefix": "derick-rs-entry",
		"body": [
		  "$${1} {",
		  "    english \"${2}\";",
		  "}",
		  "${3}",
		],
		"description": "Creates an RS entry"
	  },
	"Inspect Class Hierarchy": {
		"prefix": "derick-inspect-class-hierarchy",
		"body": [
			"cm.runtime.console.showClassViewerDummy($1);"
		],
	},
	"Quick Delivery Library Limb": {
	"prefix": "",
	"body": [
		"/**",
		" * Quick delivery.",
		" */",
		"public void polyKIMINTSeatingQdCatLimb(LibraryLimb root, str key) {",
		"    LibraryLimb parent(root, pkg, key, label=$poly);",
		"    SnapperLimb(parent, pkg, \"PolyLoungeQD\", image=polyIcon(\"PolyLounge\"), toolTipText=qdToolTipText($PolyLoungeTip));",
		"}",
		""
	],
	"description": "Quick Delivery Library Limb"
	},

	"Add Override: Catalog": {
		"prefix": "derick-catalog",
	"body": [
		"/**",
		" * Catalog per key.",
		" */",
		"public str catalog(str dataKey)  {",
		"    return dataKey == cAOMainData ? cKimIntQdCatCode : super(..);",
		"}"
	],
	"description": "Add Override: Catalog"
	},

	"Add Override: LoadFailed": {
		"prefix": "derick-loadfailed",
	"body": [
		"/**",
		" * Load failed.",
		" */",
		"public loadFailedResult loadFailed(ObjectFormatter formatter, LoadFailure failure) {",
		"    if (failure as UninitializedFieldLoadFailure) {",
		"        if (failure.field.name == \"qdChairType\") {",
		"            qdChairType = cHlQdBlackMesh;",
		"            return loadFailedResult.ignore;",
		"        }",
		"    }",
		"    return super(..);",
		"}"
	],
	"description": "Add Override: loadFailed(..)"
	},

	"Object domain(..)": {
		"prefix": "derick-object-domain",
	"body": [
		"Object domain(..) { return that.packDomain(); }"
	],
	"description": "Object domain(..)"
	},

	"addToQdLib": {
		"prefix": "derick-addtoqdlib",
	"body": [
		"addToQdLib(cProductName, [_seatingQdCat], cKIMINTBrand, [cKimIntQdCatCode], #:package);"
	],
	"description": "addToQdLib"
	},

	"Add Override: Quick Delivery Basics": {
		"prefix": "derick-quick-delivery-basics",
	"body": [
		"    /***********************************************************************",
		"     * Data",
		"     ***********************************************************************/",
		"",
		"    /**",
		"     * Catalog.",
		"     */",
		"    public str catalog(str dataKey) {",
		"        return dataKey == cAOMainData ? cKimIntQdCatCode : super(..);",
		"    }",
		"",
		"",
		"    /***********************************************************************",
		"     * Parts",
		"     ***********************************************************************/",
		"",
		"    /**",
		"     * Part number.",
		"     */",
		"    public str partNumber(str dataKey=cAOMainData) {",
		"        return dataKey == cAOMainData ? \"Q\" # super(..) : super(..);",
		"    }"
	],
	"description": "Add Override: Quick Delivery Basics"
	},

	"Add Override: Quick Delivery Basics (No dataKey)": {
		"prefix": "derick-quick-delivery-basics-no-datakey",
	"body": [
		"    /***********************************************************************",
		"     * Data",
		"     ***********************************************************************/",
		"",
		"    /**",
		"     * Catalog.",
		"     */",
		"    public str catalog(str dataKey) {",
		"        return cKimIntQdCatCode;",
		"    }",
		"",
		"",
		"    /***********************************************************************",
		"     * Parts",
		"     ***********************************************************************/",
		"",
		"    /**",
		"     * Part number.",
		"     */",
		"    public str partNumber(str dataKey=cAOMainData) {",
		"        return \"Q\" # super(..);",
		"    }"
	],
	"description": "Add Override: Quick Delivery Basics (No dataKey)"
	},

	"Add Override: Early Initialize": {
		"prefix": "derick-early-initialize",
	"body": [
		"/**",
		" * Early initialize.",
		" */",
		"public void earlyInitialize() {",
		"    super(..);",
		"}"
	],
	"description": "Add Override: Early Initialize"
	},

	"Add Override: Late Initialize": {
		"prefix": "derick-late-initialize",
	"body": [
		"/**",
		" * Late initialize.",
		" */",
		"public void lateInitialize() {",
		"    super(..);",
		"}",
		""
	],
	"description": "Add Override: Late Initialize"
	},

	"Add Override: Append Prop Defs": {
		"prefix": "derick-append-prop-defs",
	"body": [
		"/**",
		" * Append prop defs.",
		" */",
		"public props : cached=!developMode {",
		"cProductPK : fieldName=\"_\", domain=Domain(),",
		"setting=PropInputSetting(label=$,",
		"        attributes={cKimIntQuickAttr, cKimIntInsertAttr, cKimIntPersistentAttr}) {",
		"        Object get(..) { return that.get(); }",
		"        void put(..) { if (v as Symbol) that.set(v.?v); return; }",
		"}",
		"}"
	],
	"description": "Add Override: Append Prop Defs"
	},

	"Add SkuGen Override: Late Init From Sku Parts": {
		"prefix": "derick-late-init-from-sku-parts",
	"body": [
		"/**",
		" * Late init from sku parts.",
		" * Do these last because they rely on other props for their domain.",
		" */",
		"public str[] lateInitFromSkuParts() {",
		"    return [cKimIntD, cKimIntW, cKimIntH];",
		"}"
	],
	"description": "Add SkuGen Override: Late Init From Sku Parts"
	},

	"Enable Deprecated Errors (False)": {
		"prefix": "derick-enable-deprecated-errors-false",
	"body": [
		"cm.runtime.enableDeprecatedErrors(false);"
	],
	"description": "Enable Deprecated Errors (False)"
	},

	"Add Override: Nominal Width Domain": {
	"prefix": "",
	"body": [
		"/**",
		" * Nominal width domain.",
		" */",
		"public SubSet nomWidthDomain() {",
		"    return DoubleEnum([]);",
		"}"
	],
	"description": "Add Override: Nominal Width Domain"
	},

	"Add Override: Nominal Depth Domain": {
		"prefix": "derick-nominal-depth-domain",
	"body": [
