	},

	"Add SkuGen Override: Part Body and Domain": {
		"prefix": "derick-part-body-and-domain",
	"body": [
		"/**",
		" * Part body.",
		" */",
		"public void partBody(str[] subPartKeys) {",
		"    subPartKeys << \"BE\";",
		"    subPartKeys << cAusSeatNumPartKey;",
		"}",
		"",
		"",
		"/**",
		" * Part number domain.",
		" */",
		"public StrSubSet partNumberDomain(str partKey) {",
		"    switch (partKey) {",
		"      case cAusSeatNumPartKey: return StrSubSet([\"2\", \"3\"]);",
		"      default:;",
		"    }",
		"    return super(..);",
		"}"
	],
	"description": "Add Override: Part Prefix & Body"
	},

