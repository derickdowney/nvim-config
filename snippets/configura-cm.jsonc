	  },

	  "Add Override: Loaded0": {
		"prefix": "derick-loaded0-2",

		"body": [
		  "/**",
		  " * Loaded0.",
		  " */",
		  "public Object loaded0(ObjectFormatter formatter, LoadFailInfo failInfo) {",
		  "    if (pkgVersion(#:package, formatter) < version(${1:14, 6, 1})) {",
		  "        $2",
		  "    }",
		  "    return super(..);",
		  "}",
		  "",
		],
		"description": "Add Loaded0 override"
	  },

