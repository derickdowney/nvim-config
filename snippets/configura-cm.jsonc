	"Add Override: getAccessoryEnvs(..)": {
		"prefix": "getAccessoryEnvs",
		"body": [
			"/**\r",
			" * Get accessory envs.\r",
			" */\r",
			"public str->AccEnv getAccessoryEnvs() {\r",
			"    str->AccEnv res = super(..);\r",
			"\r",
			"    EmbEndCapAccessoryEnv endCapEnv(allowReplace=true);\r",
			"    res.put(endCapEnv.key, endCapEnv);\r",
			"\r",
			"    return res;\r",
			"}"
		],
