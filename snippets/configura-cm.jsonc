	"Add Override: powerInsertPos(..)": {
		"prefix": "powerInsertPos",
		"body": [
			"/**\r",
			" * Location/position for power component.\r",
			" */\r",
			"public point powerInsertPos(str locationKey, KimIntPowerComponent insert) {\r",
			"    point res();\r",
			"\r",
			"    if (insert in KimIntG1Insert) {\r",
			"        res = (0, -dimension(cKimIntD)/2, 17inch);\r",
			"        switch (locationKey) {\r",
			"          case cKimIntLeftInsert: res.x = 0;\r",
			"          case cKimIntRightInsert: res.x = dimension(cKimIntW);\r",
			"          default:;\r",
			"        }\r",
			"    }\r",
			"\r",
			"    if (insert in KimIntG10Insert) {\r",
			"        res = (0, -dimension(cKimIntD)/2, dimension(cKimIntH));\r",
			"        switch (locationKey) {\r",
			"          case cKimIntLeftInsert: res.x = 17.125inch;\r",
			"          case cKimIntCenterInsert: res.x = 36inch;\r",
			"          case cKimIntRightInsert: res.x = 54.8125inch;\r",
			"          default:;\r",
			"        }\r",
			"    }\r",
			"\r",
			"    return res;\r",
			"}"
		],
		"description": ""
	},
	"Add Elevation: Prop Def": {
		"prefix": "elevation-propdef",
		"body": [
			"double cKimIntElev {\r",
			"    Object get(..) { return that.elevation(); }\r",
			"    void put(..) {\r",
			"        that.updateElevation(v.safeDouble);\r",
			"        that.invalidate();\r",
			"    }\r",
			"    Object domain(..) { return that.elevationDomain(); }\r",
			"}"
		],
		"description": ""
	},
	"Add Elevation: Methods": {
		"prefix": "elevation-methods",
		"body": [
			"/***********************************************************************\r",
			" * Elevation\r",
			" ***********************************************************************/\r",
			"\r",
			"/**\r",
			" * Elevation domain.\r",
			" */\r",
			"extend public SubSet elevationDomain() {\r",
			"    return DistanceRange(0inch, 60inch);\r",
			"}\r",
			"\r",
			"\r",
			"/**\r",
			" * Update elevation.\r",
			" */\r",
			"extend public void updateElevation(double newElevation) {\r",
			"    setPos((pos.x, pos.y, floorPos() + newElevation));\r",
			"}\r",
			"\r",
			"\r",
			"/**\r",
			" * Elevation.\r",
			" */\r",
			"extend public double elevation() {\r",
			"    return pos.z - floorPos();\r",
			"}\r",
			"\r",
			"\r",
			"/**\r",
			" * Floor position.\r",
			" */\r",
			"extend public double floorPos() {\r",
			"    return spaceVolumeElevation(line(pos, pos + (dimension(cKimIntW), 0, 0)),\r",
			"                                visible=true,\r",
			"                                preferActiveSpaceVolumes=true);\r",
			"}\r",
			"\r",
			""
		],
		"description": ""
	},
	"Add Override: graphicsOffset() + Graphics area comment ": {
		"prefix": "graphicsOffset-areaComment",
		"body": [
			"    /***********************************************************************\r",
			"    * Graphics\r",
			"    ***********************************************************************/\r",
			"    \r",
			"    /**\r",
			"    * Graphics offset.\r",
			"    */\r",
			"    public point graphicsOffset(str key=cAOMainData) {\r",
			"        if (key == cAOMainData) {\r",
			"            return (dimension(cKimIntW)/2, dimension(cKimIntD)/2, 0);\r",
			"        }\r",
			"        return super(..);\r",
			"    }\r",
			"\r",
			""
		],
		"description": ""
	},
	"Add Override: loadFailed": {
		"prefix": "loadFailed",
		"body": [
			"/**\r",
			" * Load failed.\r",
			" */\r",
			"public loadFailedResult loadFailed(ObjectFormatter formatter, LoadFailure failure) {\r",
			"    if (failure as UninitializedFieldLoadFailure) {\r",
			"        if (failure.field.name == \"_bracketLeft\") {\r",
			"            _bracketLeft = cKimIntNo;\r",
			"            return loadFailedResult.ignore;\r",
			"        }\r",
			"        if (failure.field.name == \"_bracketRight\") {\r",
			"            _bracketRight = cKimIntNo;\r",
			"            return loadFailedResult.ignore;\r",
			"        }\r",
			"    }\r",
			"    return super(..);\r",
			"}"
		],
		"description": ""
	},
