	},

	"Add Override: Part Number": {
		"prefix": "derick-part-number",
	"body": [
		"/**",
		" * Part number.",
		" */",
		"public str partNumber(str dataKey=cAOMainData) {",
		"    if (dataKey == cAOMainData) {",
		"        StrBuf res(cPrefixPN);",
		"        return res.toS();",
		"    }",
		"    return super(..);",
		"}"
	],
	"description": "Add Override: Part Number"
	},
	
	"Add SkuGen Override: Custom Init From Sku Part": {
		"prefix": "derick-custom-init-from-sku-part",
	"body": [
		"/**",
		" * Custom init from sku part.",
		" */",
		"public bool customInitFromSkuPart(str partKey, str v) {",
		"    switch (partKey) {",
		"      case cPairSeatCountPart: {",
		"          if (v == \"1\") internalSetDimension(cKimIntW, 27inch);",
		"          else if (v == \"2\") internalSetDimension(cKimIntW, 54inch);",
		"          else if (v == \"3\") internalSetDimension(cKimIntW, 81inch);",
		"          return true;",
		"      }",
		"      default:;",
		"    }",
		"    return super(..);",
		"}"
	],
	"description": "Add SkuGen Override: Custom Init From Sku Part"
	},

	"Add SkuGen Override: Part Number Domain": {
		"prefix": "derick-part-number-domain",
	"body": [
		"/**",
		" * Part number domain.",
		" */",
		"public StrSubSet partNumberDomain(str partKey) {",
		"    switch (partKey) {",
		"      case cAusSeatNumPartKey: return StrSubSet([\"2\", \"3\"]);",
		"      default:;",
		"    }",
		"    return super(..);",
		"}"
	],
	"description": "Add Override: Part Number Domain"
	},

	"Add SkuGen Override: Part Prefix": {
		"prefix": "derick-part-prefix",

		"body": [
			"/**",
			" * Part prefix.",
			" */",
			"public str partPrefix(str dataKey=cAOMainData) {",
			"    return \"KA3\";",
			"}"
		],
		"description": "Add Override: Part Prefix"
	},

	"Add SkuGen Override: Part Body": {
		"prefix": "derick-part-body",
	"body": [
		"/**",
		" * Part body.",
		" */",
		"public void partBody(str[] subPartKeys) {",
		"    subPartKeys << \"BE\";",
		"    subPartKeys << cAusSeatNumPartKey;",
		"}"
	],
	"description": "Add Override: Part Body"
	},

	"Add SkuGen Override: Part Body and Domain": {
		"prefix": "derick-part-body-and-domain",
	"body": [
		"/**",
		" * Part body.",
		" */",
		"public void partBody(str[] subPartKeys) {",
		"    subPartKeys << \"BE\";",
		"    subPartKeys << cAusSeatNumPartKey;",
		"}",
		"",
		"",
		"/**",
		" * Part number domain.",
		" */",
		"public StrSubSet partNumberDomain(str partKey) {",
		"    switch (partKey) {",
		"      case cAusSeatNumPartKey: return StrSubSet([\"2\", \"3\"]);",
		"      default:;",
		"    }",
		"    return super(..);",
		"}"
	],
	"description": "Add Override: Part Prefix & Body"
	},

