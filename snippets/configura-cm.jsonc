	},
	"Add Override: accessorySnapPosition(..)": {
		"prefix": "accessorySnapPosition",
		"body": [
			"/**\r",
			" * Snap Position. \r",
			" * This is the point in snapper coordinates that will represent where the support \r",
			" *   is snapping to when snapping to an AccessoryLocation.\r",
			" */\r",
			"public point accessorySnapPosition(AccessoryLocation loc) {\r",
			"    return (dimension(cKimIntW)/2, dimension(cKimIntD)/2, dimension(cKimIntH));\r",
			"}"
		],
		"description": ""
	},
