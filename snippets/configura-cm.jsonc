		"prefix": "props",
		"body": [
			"/**\r",
			" * Append prop defs.\r",
			" */\r",
			"public props : cached=!developMode {\r",
			"$1 : fieldName=&:$2.name,\r",
			"    setting=PropInputSetting(label=$3, attributes=cKimIntStandardAttrs) {\r",
			"        Object  get(..)     { return that.get$4(); }\r",
			"        void    put(..)     { that.set$4(v.?$5.?v); }\r",
			"        Object  domain(..)  { return that.$6Domain(); }\r",
			"}\r",
			"}"
		],
		"description": ""
	},
	"skugen partbody partnumberdomain": {
		"prefix": "skugen-partbody-partnumberdomain",
		"body": [
			"/**\r",
			" * Part body.\r",
			" */\r",
			"public void partBody(str[] subPartKeys) {\r",
			"    subPartKeys << \"IA\";\r",
			"    subPartKeys << cKimIntArmCapPK;\r",
			"}\r",
			"\r",
			"\r",
			"/**\r",
			" * Part number domain.\r",
			" */\r",
			"public str[] partNumberDomain(str partKey) {\r",
			"    switch (partKey) {\r",
			"      case cKimIntArmCapPK: return [\"\", \"Y\", \"S\"];\r",
			"      default:;\r",
			"    }\r",
			"    return super(..);\r",
			"}\r",
			"\r",
			""
		],
		"description": ""
	},
