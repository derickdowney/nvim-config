		"public bool isVisible(Connector c) {",
		"    return super(..);",
		"}",
		""
	],
	"description": "Add isVisible(Connector c) override from Snapper"
	},

	"Add Override: Graphics Rotation": {
		"prefix": "derick-graphics-rotation",

		"body": [
		  "/**",
		  " * Graphics rotation.",
		  " */",
		  "public orientation graphicsRot(str key=cAOMainData) {",
		  "    if (key == cAOMainData) {",
		  "        return ${1:180deg};",
		  "    }",
		  "    return super(..);",
		  "}",
		  ""
		],
		"description": "Add graphics offset override used in KimInt classes"
	  },
	
	"Add Override: Graphics Offset": {
		"prefix": "derick-graphics-offset",

		"body": [
			"/**",
			" * Graphics offset.",
			" */",
			"public point graphicsOffset(str key=cAOMainData) {",
			"    if (key == cAOMainData) {",
			"        return ${1:(dimension(cKimIntW)/2, dimension(cKimIntD)/2, 0)};",
			"    }",
			"    return super(..);",
			"}"
		  ],
		"description": "Add graphics offset override used in KimInt classes"
	  },

	"Disable Deprecated Errors": {
		"prefix": "derick-disable-deprecated-errors",

		"body": [
		  "enableDeprecatedErrors(false);",
		],
