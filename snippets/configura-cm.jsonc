	"Add Override: graphicsOffset()": {
		"prefix": "graphicsOffset()",
		"body": [
			"/**\r",
			" * Graphics offset.\r",
			" */\r",
			"public point graphicsOffset(str key=cAOMainData) {\r",
			"    if (key == cAOMainData) {\r",
			"        return (dimension(cKimIntW)/2, dimension(cKimIntD)/2, 0);\r",
			"    }\r",
			"    return super(..);\r",
			"}"
		],
		"description": ""
	},
