	"accessory-from-scratch": {
		"prefix": "accessory-from-scratch",
		"body": [
			"/** Configura CET Source Copyright Notice (CETSC)\r",
			"\r",
			"   This file contains Configura CM source code and is part of the\r",
			"   Configura CET Development Platform (CETDEV). Configura CM\r",
			"   is a programming language created by Configura Sverige AB.\r",
			"   Configura, Configura CET and Configura CM are trademarks of\r",
			"   Configura Sverige AB. Configura Sverige AB owns Configura CET,\r",
			"   Configura CM, and CETDEV.\r",
			"\r",
			"   Copyright (C) 2004 Configura Sverige AB, All rights reserved.\r",
			"\r",
			"   You can modify this source file under the terms of the Configura CET\r",
			"   Source Licence Agreement (CETSL) as published by Configura Sverige AB.\r",
			"\r",
			"   Configura Sverige AB has exclusive rights to all changes, modifications,\r",
			"   and corrections of this source file. Configura Sverige AB has exclusive\r",
			"   rights to any new source file containing material from this source file.\r",
			"   A new source file based on this source file or containing material from\r",
			"   this source file has to include this Configura CET Source Copyright Notice\r",
			"   in its full content. All changes, modifications, and corrections mentioned\r",
			"   above shall be reported to Configura Sverige AB within One Month from\r",
			"   the date that the modification occurred.\r",
			"\r",
			"   Configura CM is distributed in the hope that it will be useful, but\r",
			"   WITHOUT ANY WARRANTY; without even the implied warranty of\r",
			"   MERCHANTABILITY or FITNESS FOR A PARTICULAR PURPOSE.\r",
			"   See the CETSL for more details.\r",
			"\r",
			"   You should have received a copy of the CETSL along with the CETDEV.\r",
			"   If not, write to Configura Sverige AB, Box 306, SE-581 02 Linköping, Sweden.\r",
			"   Tel +46 13377800, Fax +46 13377855,\r",
			"   Email: info@configura.com, www.configura.com\r",
			"\r",
			"   END OF CETSC\r",
			"*/\r",
			"package custom.kimballinternational.national.accessory;\r",
			"\r",
			"\r",
			"/**\r",
			" * National accessory keyboard tray quick delivery.\r",
			" */\r",
			"public class NacKeyboardTrayQD extends KimIntSurfaceAccessory {\r",
			"\r",
			"    /***********************************************************************\r",
			"     * Initialization\r",
			"     ***********************************************************************/\r",
			"\r",
			"    /**\r",
			"     * Brand env.\r",
			"     */\r",
			"    public KimIntBrandEnv brandEnv() {\r",
			"        return natBrandEnv();\r",
			"    }\r",
			"\r",
			"\r",
			"    /**\r",
			"     * Initialize data.\r",
			"     */\r",
			"    public void initializeData() {\r",
			"        super();\r",
			"        syncData();\r",
			"    }\r",
			"\r",
			"\r",
			"    /***********************************************************************\r",
			"     * Domains\r",
			"     ***********************************************************************/\r",
			"\r",
			"    /**\r",
			"     * Width domain.\r",
			"     */\r",
			"    public SubSet widthDomain() {\r",
			"        return DoubleEnum(23.5inch);\r",
			"    }\r",
			"\r",
			"\r",
			"    /**\r",
			"     * Depth domain.\r",
			"     */\r",
			"    public SubSet depthDomain() {\r",
			"        return DoubleEnum(13.938inch);\r",
			"    }\r",
			"\r",
			"\r",
			"    /**\r",
			"     * Height domain.\r",
			"     */\r",
			"    public SubSet heightDomain() {\r",
			"        return DoubleEnum(1.375inch);\r",
			"    }\r",
			"\r",
			"\r",
			"    /***********************************************************************\r",
			"     * Connectors\r",
			"     ***********************************************************************/\r",
			"\r",
			"    /**\r",
			"     * Returns true if the snap 's' of this snapper is allowed to snap to the attach 'a'.\r",
			"     */\r",
			"    public bool allowSnap(Connector s, Connector a) {\r",
			"        return false;\r",
			"    }\r",
			"\r",
			"\r",
			"    /**\r",
			"     * Returns true if the attach 'a' of this snapper is allowed to attach to the snap 's'.\r",
			"     */\r",
			"    public bool allowAttach(Connector a, Connector s) {\r",
			"        return false;\r",
			"    }\r",
			"\r",
			"\r",
			"    /***********************************************************************\r",
			"     * Graphics\r",
			"     ***********************************************************************/\r",
			"\r",
			"    /**\r",
			"     * Graphics offset.\r",
			"     */\r",
			"    public point graphicsOffset(str key=cAOMainData) {\r",
			"        return (dimension(cKimIntW)/2, dimension(cKimIntD)/2, -25.0625inch);\r",
			"    }\r",
			"\r",
			"\r",
			"    /***********************************************************************\r",
			"     * Data\r",
			"     ***********************************************************************/\r",
			"    /**\r",
			"     * Catalog per key.\r",
			"     */\r",
			"    public str catalog(str dataKey)  {\r",
			"        return cKimIntQdCatCode;\r",
			"    }\r",
			"\r",
			"\r",
			"    /***********************************************************************\r",
			"     * Parts\r",
			"     ***********************************************************************/\r",
			"\r",
			"    /**\r",
			"     * Part type.\r",
			"     */\r",
			"    public str partNumber(str dataKey=cAOMainData) {\r",
			"        return \"QNAC1424KT\";\r",
			"    }\r",
			"\r",
			"}"
		],
		"description": ""
	},
